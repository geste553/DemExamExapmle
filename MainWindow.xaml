<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь" Height="600" Width="900" WindowStartupLocation="CenterScreen" Icon="/Icon.png">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch" Width="200" Padding="5" TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text=" Поиск | " VerticalAlignment="Center"/>

            <ComboBox x:Name="CmbSort" Width="150" Margin="5,0" SelectionChanged="CmbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По возрастанию цены"/>
                <ComboBoxItem Content="По убыванию цены"/>
            </ComboBox>
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem Header="Товары">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="LvProducts" Grid.Row="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Фото" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding FullPhotoPath}" Width="60" Height="60" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Артикул" DisplayMemberBinding="{Binding Article}" Width="80"/>
                                <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price}" Width="80"/>
                                <GridViewColumn Header="Скидка %" DisplayMemberBinding="{Binding Sale}" Width="70"/>
                                <GridViewColumn Header="Цена со скидкой" DisplayMemberBinding="{Binding FinalPrice, StringFormat=\{0:0.##\}}" Width="100"/>
                                <GridViewColumn Header="Кол-во" DisplayMemberBinding="{Binding Count}" Width="60"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel x:Name="AdminPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Добавить" Margin="5" Padding="10" Click="BtnAdd_Click"/>
                        <Button Content="Редактировать" Margin="5" Padding="10" Click="BtnEdit_Click"/>
                        <Button Content="Удалить" Margin="5" Padding="10" Click="BtnDelete_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы" x:Name="TabOrders">
                <ListView x:Name="LvOrders">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding Id}" Width="60"/>
                            <GridViewColumn Header="Артикулы" DisplayMemberBinding="{Binding Article}" Width="200"/>
                            <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding DateOrder, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                            <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientFullName}" Width="150"/>
                            <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

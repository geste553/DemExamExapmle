<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="400" Width="400" WindowStartupLocation="CenterScreen" Icon="/Icon.png">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="TxtLogin" Margin="0,0,0,10" Padding="5"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,20" Padding="5"/>
            <Button Content="Войти" Click="BtnLogin_Click" Padding="10" Margin="0,0,0,10"/>
            <Button Content="Войти как гость" Click="BtnGuest_Click" Padding="10" Background="#FFBEBEBE"/>
        </StackPanel>
    </Grid>
</Window>